# /etc/vpub-exporter.env — copy this file, fill in real values, chmod 0600 admin:admin.
#
# WARNING (Constitution IV):
#   - DO NOT parse /home/admin/v-publisher/config.json from this binary.
#   - Each secret below is injected via env ONLY, never derived from publisher state.
#   - The exporter never logs values; key names are fine.

# --- Tier 0 (US1 / MVP) -------------------------------------------------------

# Root directory holding component log dirs (visor / bridge-voter /
# reference-oracle-publisher / outcome-voter).
# research.md R-001 — confirm on first run (default below assumes service
# launches with `--log-dir log` and WorkingDirectory=/home/admin/v-publisher).
VPUB_LOG_DIR=/home/admin/v-publisher/log

# Path to the locally-installed publisher binary (used by Tier 2 mtime collector,
# but harmless to set on day 1).
VPUB_BINARY_PATH=/home/admin/v-publisher/visor

# --- Tier 1 (US2) ------------------------------------------------------------

# Comma-separated list of Arbitrum RPC provider names (lowercase).
# Each name N also requires VPUB_RPC_<N upper>_URL below.
# Leave empty to disable Tier 1 bridge collectors.
# VPUB_BRIDGE_RPC_NAMES=alchemy,infura,quicknode,chainstack,ankr,drpc,custom1

# Per-provider URLs (secrets — keep this file 0600).
# VPUB_RPC_ALCHEMY_URL=https://...
# VPUB_RPC_INFURA_URL=https://...
# VPUB_RPC_QUICKNODE_URL=https://...
# VPUB_RPC_CHAINSTACK_URL=https://...
# VPUB_RPC_ANKR_URL=https://...
# VPUB_RPC_DRPC_URL=https://...
# VPUB_RPC_CUSTOM1_URL=https://...

# Slack bot token used by auth.test + conversations.history.
# MUST be the same token publisher uses to post Slack alerts.
# Leave empty to disable Slack collectors.
# CHANGE_ME
# VPUB_SLACK_BOT_TOKEN=

# Slack channel ID (not name) of the outcome_actions channel.
# R-007 — fill from `conversations.list`.
# VPUB_OUTCOME_CHANNEL=

# Log-pattern overrides (FR-020). Each var is newline-separated regexes.
# Defaults live in internal/config/config.go and may need tuning after R-003.
# VPUB_VOTE_OK_PATTERNS=(?i)vote.*(submitted|ok|success)
# VPUB_VOTE_FAIL_PATTERNS=(?i)vote.*(fail|error)
# VPUB_DISAGREEMENT_PATTERNS=(?i)disagree
# VPUB_LOG_WARN_PATTERNS=(?i)\bwarn\b
# VPUB_LOG_CRIT_PATTERNS=(?i)\bcrit
#   ERROR

# --- Tier 2 (US3) ------------------------------------------------------------

# HF-announced publisher binary download URL.
# Testnet: https://binaries.hyperliquid-testnet.xyz/validator-publisher/visor
# Mainnet: confirm at gov-time (R-006).
# Leave empty to disable upgrade tracking.
# VPUB_BINARY_URL=
