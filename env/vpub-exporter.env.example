# /etc/vpub-exporter.env — copy this file, fill in real values, chmod 0600.
#
# WARNING (Constitution IV):
#   - DO NOT parse /home/admin/v-publisher/config.json from this binary.
#   - Each secret below is injected via env ONLY, never derived from publisher state.
#   - The exporter never logs values; key names are fine.
#
# User per network:
#   testnet machine: user=admin   (WorkingDirectory=/home/admin/v-publisher)
#   mainnet machine: user=ubuntu  (WorkingDirectory=/home/ubuntu/v-publisher)
# Adjust paths below accordingly.

# --- Tier 0 (US1 / MVP) -------------------------------------------------------

# Visor self log directory (--log-dir/visor 서브폴더).
# R-026 (HF README 2026-06-06): visor 가 `--log-dir <path>` 명시 시 자체 로그는
# `<path>/visor/YYYYMMDD` 에 기록 (옛 R-001 의 "visor 가 root 직접" 가정 폐기).
# 사용자 운영: visor 가 `--log-dir log` (publisher cwd 기준 relative path) 로 실행됨.
#   testnet: /home/admin/v-publisher/log/visor
#   mainnet: /home/ubuntu/v-publisher/log/visor
VPUB_VISOR_LOG_DIR=/home/admin/v-publisher/log/visor

# Root directory where visor writes ALL 4 component logs.
# R-026 (HF README): `--log-dir <path>` 명시 시 visor + 4 child 모두 `<path>/<component>/`
# 사용하므로 publisher 의 `log/` 자체를 가리킴. (옛 R-001 의 "/tmp/validator-publisher
# hard-code" 가정 폐기 — 그건 `--log-dir` 생략 시 visor default 일 뿐.)
#   testnet: /home/admin/v-publisher/log
#   mainnet: /home/ubuntu/v-publisher/log
# Inside this dir: visor/YYYYMMDD, bridge-voter/YYYYMMDD, reference-oracle-publisher/YYYYMMDD,
#                  outcome-voter/YYYYMMDD
VPUB_COMPONENT_LOG_DIR=/home/admin/v-publisher/log

# Per-component binary paths for Tier 2 tracking (R-019, 2026-05-24).
# Format: <component>=<path>,<component>=<path>,...
# 4 components: visor (manual install), bridge-voter / outcome-voter /
# reference-oracle-publisher (visor 가 /<child>/active polling 으로 자동 download).
# 비어 있으면 defaults (/home/admin/v-publisher/<component>) 사용.
VPUB_BINARY_TARGETS=visor=/home/admin/v-publisher/visor,bridge-voter=/home/admin/v-publisher/bridge-voter,outcome-voter=/home/admin/v-publisher/outcome-voter,reference-oracle-publisher=/home/admin/v-publisher/reference-oracle-publisher

# Legacy single-binary path (visor only). When set, folds into VPUB_BINARY_TARGETS[visor].
# Prefer VPUB_BINARY_TARGETS above for new deployments.
# VPUB_BINARY_PATH=/home/admin/v-publisher/visor

# Bridge voter state JSON — read-only progress signal.
# File contents: {"last_scanned_block": <int>, "transactions": {...}}
# Path pattern: ~/v-publisher/bridge-voter-<chain>-state.json
# Testnet: bridge-voter-testnet-state.json
# Mainnet: bridge-voter-mainnet-state.json
# FR-012a — stronger health signal than log mtime.
VPUB_BRIDGE_STATE_PATH=/home/admin/v-publisher/bridge-voter-testnet-state.json

# --- Tier 1 (US2) ------------------------------------------------------------

# Comma-separated Arbitrum RPC provider names (lowercase).
# Each name N also requires VPUB_RPC_<N upper>_URL below.
# Leave empty to disable Tier 1 bridge collectors.
#
# Testnet (Arbitrum Sepolia): typically 3 providers
# VPUB_BRIDGE_RPC_NAMES=alchemy,quicknode,infura
#
# Mainnet (Arbitrum One): 7 providers required
# VPUB_BRIDGE_RPC_NAMES=alchemy,quicknode,infura,chainstack,ankr,drpc,custom1

# Per-provider URLs (secrets — file 0600).
# VPUB_RPC_ALCHEMY_URL=https://...
# VPUB_RPC_QUICKNODE_URL=https://...
# VPUB_RPC_INFURA_URL=https://...
# VPUB_RPC_CHAINSTACK_URL=https://...
# VPUB_RPC_ANKR_URL=https://...
# VPUB_RPC_DRPC_URL=https://...
# VPUB_RPC_CUSTOM1_URL=https://...

# Slack bot token used by auth.test + conversations.history.
# Same token publisher uses to post Slack alerts.
# Required scopes: auth:read, channels:history, groups:history
# Leave empty to disable Slack collectors.
# CHANGE_ME
# VPUB_SLACK_BOT_TOKEN=

# Slack channel ID (not name) of the outcome_actions channel.
# R-007 — get from `conversations.list` or Slack web UI right-click → Copy link.
# VPUB_OUTCOME_CHANNEL=

# Log-pattern overrides (FR-020). Each var is newline-separated regexes (|-separated within one regex).
# Defaults below mirror real bridge-voter / outcome-voter / reference-oracle-publisher
# log lines as of testnet 2026-05-23.
#
# bridge-voter: vote stats are NOT separate lines — they're integer fields in
# the periodic "scanned" summary line. The exporter uses a structured matcher,
# but the regex below acts as the trigger.
# Real line:
#   2026-05-23T... INFO  validator_publisher::bridge_voter::runner: scanned from_block=N to_block=N ... votes_sent=N votes_skipped=N votes_failed=N deposits=N advanced_to="N"
# VPUB_VOTE_OK_PATTERNS=validator_publisher::bridge_voter::runner: scanned .* votes_sent=([1-9]\d*)
# VPUB_VOTE_FAIL_PATTERNS=validator_publisher::bridge_voter::runner: scanned .* votes_failed=([1-9]\d*)
#
# bridge-voter RPC provider HTTP fail (R-013, mainnet 2026-06-06 confirmed:
# publisher never emits real "disagreement" line; what we tracked was
# per-provider HTTP error). Capture groups: 1=provider name, 2=HTTP status code.
# Metric: vpub_bridge_rpc_provider_fail_total{name, status_code}.
# (Old env name VPUB_DISAGREEMENT_PATTERNS still honored as backward compat.)
# VPUB_PROVIDER_FAIL_PATTERNS=WARN\s+validator_publisher::bridge_voter::runner: RPC failed.*provider="([^"]+)".*status (\d{3})
#
# reference-oracle-publisher vote ok / fail (R-024 mainnet 2026-06-06 confirmed):
#   ok  : INFO  validator_publisher::reference_oracle_publisher: oracle action sent
#   fail: CRIT  validator_publisher::reference_oracle_publisher: critical error failed to publish oracle action error=...
# (Old [45]xx exchange_client pattern missed status=200 + "Missing price" array.)
# VPUB_ORACLE_OK_PATTERNS=validator_publisher::reference_oracle_publisher: oracle action sent
# VPUB_ORACLE_FAIL_PATTERNS=CRIT\s+validator_publisher::reference_oracle_publisher.*: critical error failed to publish oracle action
#
# outcome-voter log levels (parsed from "  WARN " / "  CRIT " / "  ERROR ").
# The 4-char level field is preceded by 2 spaces (timestamp ws).
# VPUB_LOG_WARN_PATTERNS=\s+WARN\s+validator_publisher::outcome_voter
# VPUB_LOG_CRIT_PATTERNS=\s+(CRIT|ERROR)\s+validator_publisher::outcome_voter

# --- Tier 2 (US3) ------------------------------------------------------------

# HF-announced publisher binary download URL.
# Testnet: https://binaries.hyperliquid-testnet.xyz/validator-publisher/visor
# Mainnet: confirm at gov-time (R-006).
# Leave empty to disable upgrade tracking.
# VPUB_BINARY_URL=https://binaries.hyperliquid-testnet.xyz/validator-publisher/visor
