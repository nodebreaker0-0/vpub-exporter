[Unit]
Description=vpub-exporter — read-only Prometheus exporter for hl-validator-publisher
Documentation=https://github.com/bharvest/vpub-exporter
After=network-online.target validator-publisher.service
Wants=network-online.target
# BindsTo intentionally NOT set — exporter must stay up even if v-publisher dies
# (otherwise we lose the very alarm we exist for).

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/vpub-exporter
EnvironmentFile=/etc/vpub-exporter.env
ExecStart=/home/admin/vpub-exporter/bin/vpub-exporter \
  --listen-addr=:8002 \
  --service-name=validator-publisher.service \
  --scrape-interval=30s
Restart=on-failure
RestartSec=5s

# Security — Constitution II / IV.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
# PrivateTmp must be NO — publisher writes its 3 child component logs to
# /tmp/validator-publisher/ (visor default), and we need to read those.
# Mirrors publisher's own v-publisher.service.full PrivateTmp=false.
PrivateTmp=no
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Make the publisher tree explicitly read-only to this unit (defense in depth).
ReadOnlyPaths=/home/admin/v-publisher
# /etc/vpub-exporter.env is mode 0600 — readable only to root + admin
LimitNOFILE=65536
LimitNPROC=512

# Resource budget — constitution Operational Constraints.
MemoryMax=200M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
