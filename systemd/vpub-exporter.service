[Unit]
Description=vpub-exporter — read-only Prometheus exporter for hl-validator-publisher
Documentation=https://github.com/bharvest/vpub-exporter
After=network-online.target validator-publisher.service
Wants=network-online.target
# BindsTo intentionally NOT set — exporter must stay up even if v-publisher dies
# (otherwise we lose the very alarm we exist for).

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/vpub-exporter
EnvironmentFile=/etc/vpub-exporter.env
ExecStart=/home/admin/vpub-exporter/bin/vpub-exporter \
  --listen-addr=:8002 \
  --service-name=validator-publisher.service \
  --scrape-interval=30s
Restart=on-failure
RestartSec=5s

# Constitution II — defense in depth. publisher 디렉토리 read-only 강제.
# /etc/vpub-exporter.env 는 mode 0600 (root+admin only).
ReadOnlyPaths=/home/admin/v-publisher

# File descriptor 한계 — RPC + slack + log tail 동시 open 마진.
LimitNOFILE=65536

# R-027 (2026-06-08 운영 발견): MemoryMax/CPUQuota/sandbox hardening 다수
# 제거. Go runtime startup 메모리가 옛 MemoryMax=200M cgroup 한계 도달 →
# fork() EAGAIN (status=203/EXEC) 반복. 다른 sandbox 옵션들도 일부 환경에서
# binary exec 직전 EAGAIN 유발 가능. 운영 표준 = 최소 sandbox + ReadOnlyPaths.
# (옛 hardened 형태는 README ko/en 의 "Hardened systemd alternative" 섹션 참조.)

[Install]
WantedBy=multi-user.target
