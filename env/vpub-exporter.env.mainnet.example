# vpub-exporter env — mainnet (PLACEHOLDER until R-006 announce).
#
# Status (2026-05-24):
#   - Publisher binary URL: HF mainnet announce TBD. Best guess uses the
#     non-testnet hostname pattern. Replace before mainnet gov-time.
#   - User account: expected `ubuntu` (per validator-publisher README), homedir
#     /home/ubuntu/v-publisher.  Mainnet host may differ — confirm at install.
#   - 7 Arbitrum RPC providers required (testnet uses 3). Names per README:
#     alchemy / quicknode / infura / chainstack / ankr / drpc / <7th choice>
#     (validator's own Arbitrum node is allowed for the 7th).
#
# Differences vs testnet env:
#   - VPUB_VISOR_LOG_DIR / VPUB_BINARY_TARGETS — /home/ubuntu/v-publisher/...
#   - VPUB_BINARY_URL — binaries.hyperliquid.xyz (no -testnet)
#   - 7 RPCs (testnet 3)
#   - Slack channel IDs same as testnet (operators read both)

VPUB_VISOR_LOG_DIR=/home/ubuntu/v-publisher/log
VPUB_COMPONENT_LOG_DIR=/tmp/validator-publisher

# Per-component binary paths (R-019). All under /home/ubuntu/v-publisher.
VPUB_BINARY_TARGETS=visor=/home/ubuntu/v-publisher/visor,bridge-voter=/home/ubuntu/v-publisher/bridge-voter,outcome-voter=/home/ubuntu/v-publisher/outcome-voter,reference-oracle-publisher=/home/ubuntu/v-publisher/reference-oracle-publisher

# Mainnet visor announce URL (R-006 TBD). HF Telegram / Discord announce 후 정정.
VPUB_BINARY_URL=https://binaries.hyperliquid.xyz/validator-publisher/visor

VPUB_BRIDGE_STATE_PATH=/home/ubuntu/v-publisher/bridge-voter-mainnet-state.json

# 7 RPC providers required for mainnet (README).
VPUB_BRIDGE_RPC_NAMES=alchemy,quicknode,infura,chainstack,ankr,drpc,<7th-name>
# VPUB_RPC_ALCHEMY_URL=https://arb-mainnet.g.alchemy.com/v2/<KEY>
# VPUB_RPC_QUICKNODE_URL=https://<ENDPOINT>.arbitrum-mainnet.quiknode.pro/<KEY>/
# VPUB_RPC_INFURA_URL=https://arbitrum-mainnet.infura.io/v3/<KEY>
# VPUB_RPC_CHAINSTACK_URL=https://<ENDPOINT>.core.chainstack.com/<KEY>
# VPUB_RPC_ANKR_URL=https://rpc.ankr.com/arbitrum/<KEY>
# VPUB_RPC_DRPC_URL=https://lb.drpc.org/ogrpc?network=arbitrum&dkey=<KEY>
# VPUB_RPC_<7TH-NAME>_URL=https://...

# Slack (same workspace as testnet).
# VPUB_SLACK_BOT_TOKEN=<rotate-and-inject>
# VPUB_OUTCOME_CHANNEL=<channel-id>
